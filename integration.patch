--- a/macos/Sources/Features/Terminal/TerminalViewContainer.swift
+++ b/macos/Sources/Features/Terminal/TerminalViewContainer.swift
@@ -1,10 +1,31 @@
 import AppKit
 import SwiftUI
+import GhosttyKit
 
 /// Use this container to achieve a glass effect at the window level.
 /// Modifying `NSThemeFrame` can sometimes be unpredictable.
 class TerminalViewContainer: NSView {
     private let terminalView: NSView
+    private var cursorTrailView: CursorTrailView?
+
+    func resetCursorTrail() { cursorTrailView?.reset() }
+
+    func showCursorTrail(_ sample: ghostty_cursor_trail_sample_s, from surface: Ghostty.SurfaceView) {
+        guard surface.focused, window?.isKeyWindow == true else { return }
+        if sample.hold_ms == 0 {
+            cursorTrailView?.removeFromSuperview()
+            cursorTrailView = nil
+            return
+        }
+
+        let overlay = cursorTrailView ?? CursorTrailView(frame: bounds)
+        if cursorTrailView == nil {
+            addSubview(overlay, positioned: .above, relativeTo: terminalView)
+            overlay.autoresizingMask = [.width, .height]
+            cursorTrailView = overlay
+        }
+        overlay.update(sample, from: surface)
+    }
 
     /// Background color applied with glass effect
     private(set) var glassEffectView: NSView?
